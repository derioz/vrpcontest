rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Identity Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(email) {
      return isAuthenticated() && request.auth.token.email.lower() == email.lower();
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return (isAuthenticated() && request.auth.token.email.lower() == 'tx.davidj@gmail.com')
             || hasRole('superadmin')
             || hasRole('owner');
    }

    function isAdmin() {
      return isSuperAdmin() || hasRole('admin');
    }

    function isEditor() {
      return isAdmin() || hasRole('editor');
    }

    // Helper to verify user identity matching Firebase Auth UID or Discord Provider UID
    function isUser(targetUserId) {
      return isAuthenticated()
             && (
                 request.auth.uid == targetUserId
                 || (
                     'identities' in request.auth.token.firebase
                     && 'oidc.discord' in request.auth.token.firebase.identities
                     && request.auth.token.firebase.identities['oidc.discord'].size() > 0
                     && request.auth.token.firebase.identities['oidc.discord'][0] == targetUserId
                 )
             );
    }

    // --- Global Website Collections ---
    match /users/{userId} {
      allow read, write: if true;
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isEditor() || isAdmin();
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- VITAL CONTEST APP COLLECTIONS ---

    // Admins collection — public read to verify admin rights; write strictly denied from client
    match /admins/{discordId} {
      allow read: if true;
      allow write: if false;
    }

    // Contest metadata — public read and write
    match /contests/{contestId} {
      allow read, write: if true;
    }

    // Global settings (votingOpen, submissionsOpen, categorySuggestionMode, etc.) — public read and write
    match /settings/{doc} {
      allow read, write: if true;
    }

    // Secrets collection (encrypted private keys)
    match /secrets/{doc} {
      allow read, write: if true;
    }

    // Contest categories
    match /categories/{doc} {
      allow read, write: if true;
    }

    // Photo contest submissions
    match /photos/{doc} {
      allow read, create, update, delete: if true;
    }

    // Photo contest votes
    match /votes/{doc} {
      allow read, create, update, delete: if true;
    }

    // Archive: winners saved at end of contest — public read, admin write
    match /archived_winners/{docId} {
      allow read, write: if true;
    }

    // User stats: lifetime cumulative counts — public read, admin write
    match /user_stats/{userId} {
      allow read, write: if true;
    }

    // General contest submissions
    match /submissions/{submissionId} {
      allow read, create, update, delete: if true;
    }

    // Category Suggestions: community proposals
    match /category_suggestions/{suggestionId} {
      allow read, create, update, delete: if true;
    }

    // Category Suggestion Votes: Reddit-style community votes
    match /category_suggestion_votes/{voteId} {
      allow read, create, update, delete: if true;
    }

    // Category Suggestion Beta Testers Whitelist — public read, admin write
    match /suggestion_beta_testers/{discordId} {
      allow read, write: if true;
    }

    // Flagged alt accounts (blacklist) — public read, admin write
    match /flagged_voters/{docId} {
      allow read, write: if true;
    }

    // Archived historical votes
    match /archived_votes/{docId} {
      allow read, write: if true;
    }

    // Bug reports — anyone can submit; only admins can read or manage
    match /bug_reports/{docId} {
      allow read, write: if true;
    }

    // Changelogs — public read, admin write
    match /changelogs/{docId} {
      allow read, write: if true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
